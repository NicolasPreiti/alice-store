generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  EMPLOYEE
}

enum PaymentMethod {
  CASH
  MERCADO_PAGO
}

enum DebtStatus {
  OPEN
  PARTIAL
  PAID
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  sales        Sale[]
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]
}

model Product {
  id          String    @id @default(uuid())
  name        String
  sku         String    @unique
  cost        Decimal   @db.Decimal(10, 2)
  price       Decimal   @db.Decimal(10, 2)
  description String?
  stock       Int       @default(0)
  categoryId  String
  category    Category  @relation(fields: [categoryId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  saleItems   SaleItem[]

  @@index([categoryId])
}

model Client {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  notes     String?
  createdAt DateTime @default(now())
  sales     Sale[]
  debts     Debt[]
}

model Sale {
  id        String        @id @default(uuid())
  number    Int           @unique
  userId    String
  user      User          @relation(fields: [userId], references: [id])
  clientId  String?
  client    Client?       @relation(fields: [clientId], references: [id])
  total     Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())
  items     SaleItem[]
  payments  SalePayment[]
  debt      Debt?

  @@index([userId])
  @@index([clientId])
  @@index([createdAt])
}

model SaleItem {
  id           String  @id @default(uuid())
  saleId       String
  sale         Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId    String
  product      Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  productName  String
  productCost  Decimal @db.Decimal(10, 2)
  productPrice Decimal @db.Decimal(10, 2)
  quantity     Int
  subtotal     Decimal @db.Decimal(10, 2)

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id        String        @id @default(uuid())
  saleId    String
  sale      Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  method    PaymentMethod
  amount    Decimal       @db.Decimal(10, 2)
  createdAt DateTime      @default(now())

  @@index([saleId])
}

model Debt {
  id        String     @id @default(uuid())
  clientId  String
  client    Client     @relation(fields: [clientId], references: [id])
  saleId    String?   @unique
  sale      Sale?     @relation(fields: [saleId], references: [id], onDelete: Restrict)
  amount    Decimal    @db.Decimal(10, 2)
  paid      Decimal    @default(0) @db.Decimal(10, 2)
  status    DebtStatus @default(OPEN)
  createdAt DateTime   @default(now())
  payments  Payment[]

  @@index([clientId])
  @@index([status])
}

model Payment {
  id        String        @id @default(uuid())
  debtId    String
  debt      Debt          @relation(fields: [debtId], references: [id], onDelete: Restrict)
  amount    Decimal       @db.Decimal(10, 2)
  method    PaymentMethod
  createdAt DateTime      @default(now())

  @@index([debtId])
}
