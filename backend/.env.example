# Neon.tech PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Separate database used by e2e tests (never the dev/prod one)
DATABASE_URL_TEST="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# JWT (must be at least 16 characters)
JWT_SECRET="change-me-to-a-strong-32-char-secret"

# Server
PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Swagger UI at /docs (defaults to enabled unless NODE_ENV=production)
SWAGGER_ENABLED="true"

# Seed admin (optional — defaults: admin@store.local / admin123)
SEED_ADMIN_EMAIL="admin@store.local"
SEED_ADMIN_PASSWORD="admin123"
